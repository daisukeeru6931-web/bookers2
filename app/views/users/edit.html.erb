<div class="container">
  <div class="row">
    <div class="col-md-6 mx-auto">
      <h2>User info</h2>

      <% if @user.errors.any? %>
        <div>
          <h4><%= @user.errors.count %> errors prohibited this obj from being saved:</h4>
          <ul>
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @user do |f| %>
        <div class="mb-3">
          <%= f.label :name, "Name" %>
          <%= f.text_field :name, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :profile_image, "Image" %><br>
          <%= f.file_field :profile_image, accept: "image/*" %>
        </div>

        <div class="mb-3">
          <%= f.label :introduction, "Introduction" %>
          <%= f.text_area :introduction, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.submit "Update User", class: "btn btn-secondary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>